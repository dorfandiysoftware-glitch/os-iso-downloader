<Window
    x:Class="OsIsoDownloader.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0" Height="40">
            <TextBlock Text="OS ISO Downloader" VerticalAlignment="Center" Margin="14,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <Grid Grid.Row="1" Margin="16,0,16,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- Wizard -->
            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BackButton" Click="OnBack" IsEnabled="False" ToolTipService.ToolTip="Назад">
                        <FontIcon Glyph="&#xE72B;" />
                    </Button>
                    <TextBlock x:Name="PathText" Text="Завантажити" VerticalAlignment="Center"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <TextBlock x:Name="StepText" Grid.Row="1" Text="" Opacity="0.7" TextWrapping="Wrap" />
                <TextBox x:Name="SearchBox" Grid.Row="2" PlaceholderText="Пошук…" TextChanged="OnSearch" />
                <GridView x:Name="Choices" Grid.Row="3" IsItemClickEnabled="True" ItemClick="OnChoice"
                          SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="190" Height="120" Padding="12" RowSpacing="6" CornerRadius="8"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid Width="34" Height="34" HorizontalAlignment="Left">
                                        <Ellipse Fill="{Binding Brush}" />
                                        <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding Star}" HorizontalAlignment="Right" FontSize="18" />
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="2" Text="{Binding Subtitle}" Opacity="0.7" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" MaxLines="3"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <TextBlock x:Name="CatalogText" Grid.Row="4" Opacity="0.6"
                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
            </Grid>

            <!-- Downloads -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Завантаження" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <Button Content="Змінити теку" Click="OnPickFolder" />
                    <TextBlock x:Name="FolderText" VerticalAlignment="Center" Opacity="0.7"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
                <ListView x:Name="Downloads" Grid.Row="1" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,8" RowSpacing="4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Content="{Binding ActionLabel}" Click="OnItemAction" Tag="{Binding}" />
                                <Button Grid.Column="2" Content="Створити ВМ" Click="OnItemVm" Tag="{Binding}"
                                        Visibility="{Binding VmVisibility}" />
                                <Button Grid.Column="3" Content="Прибрати" Click="OnItemCancel" Tag="{Binding}" />
                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="4" Minimum="0" Maximum="100" Value="{Binding Percent}" />
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Text="{Binding Status}" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Window>
